---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from '../components/Icon.astro';
import { formatRange, formatStat, getPortfolio } from '../lib/content';
import Layout from '../layouts/Layout.astro';

const { profile, highlights, projects, experience } = await getPortfolio();
const roles = experience.filter((job) => job.kind !== 'earlier');
const [first, ...last] = profile.name.split(' ');
const credential = (await getEntry('credentials', 'level-4-software-developer'))?.data;
---

<Layout>
  <Fragment slot="band">
    <div class="band-side">
      <p>{profile.intro} {profile.availability}</p>
    </div>
    <h1 class="giant" aria-label={profile.name}>
      <span class="word" aria-hidden="true" style="--w:0">{first}</span>{' '}
      <span class="word fade" aria-hidden="true" style="--w:1">{last.join(' ')}</span>
    </h1>
  </Fragment>

  <section class="section">
    <h2 class="eyebrow">Selected projects</h2>
    <div class="big-rows">
      {
        projects.map((project) => (
          <a class="big-row reveal" href={`/projects/${project.slug}`}>
            <h3 class="big-row-title">{project.title}</h3>
            <span class="big-row-meta">{project.platform}, {project.year}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <p class="statement reveal">{profile.summary}</p>
    <p style="margin-block-start:24px"><a class="link" href="/about">More about me</a></p>
  </section>

  <section class="section">
    <ul class="stats">
      {
        highlights.map((highlight) => (
          <li class="reveal">
            <p class="stat-value">{formatStat(highlight)}</p>
            <p class="stat-label">{highlight.label}</p>
            <p class="stat-detail">{highlight.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="eyebrow">Experience</h2>
    <div class="big-rows">
      {
        roles.map((job) => (
          <a class="big-row reveal" href="/experience">
            <h3 class="big-row-title sm">{job.company}</h3>
            <span class="big-row-meta">{job.role}<br />{formatRange(job.start, job.end)}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    credential && (
      <section class="section">
        <h2 class="eyebrow">Education</h2>
        <a class="home-credential" href="/education">
          <Image src={credential.badge} alt="" width={96} height={96} />
          <div>
            <strong>{credential.title}, {credential.grade}</strong>
            <span>{credential.issuer}. How I got there, and how to verify it</span>
          </div>
        </a>
      </section>
    )
  }

  <a class="closing" href="/contact">
    <p>{profile.availability}</p>
    <strong>Let's chat <Icon name="arrow-up-right" size={64} stroke={1.25} /></strong>
  </a>
</Layout>
