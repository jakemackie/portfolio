---
import { getPortfolio } from '../../../lib/content';
import Layout from '../../../themes/cobalt/Layout.astro';

const { profile, skills, education } = await getPortfolio();
---

<Layout title="About">
  <Fragment slot="hero">
    <h1 class="heading">A bit <em>about me</em></h1>
    <p class="hero-sub" style="margin-block-end:0">{profile.summary}</p>
  </Fragment>

  <section class="section columns">
    <div class="body-text">
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <aside class="panel">
      <p class="small-meta">Where</p>
      <p>{profile.location}</p>
      <p class="small-meta" style="margin-block-start:16px">Status</p>
      <p>{profile.availability}</p>
      <p class="small-meta" style="margin-block-start:16px">Email</p>
      <p style="overflow-wrap:anywhere"><a class="link" href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </aside>
  </section>

  <section class="section">
    <h2 class="title">Skills</h2>
    <div class="card-list three" style="margin-block-start:24px">
      {
        skills.map((group, index) => (
          <article class:list={['service', { on: index === 2 }]}>
            <h3>{group.label}</h3>
            <p>{group.items.join(', ')}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="title">Education</h2>
    <div class="card-list three" style="margin-block-start:24px">
      {
        education.map((school) => (
          <article class="panel">
            <p class="small-meta">{school.from} – {school.to}</p>
            <h3 style="font-weight:500;font-size:20px;letter-spacing:-.015em;margin-block:4px 16px">{school.institution}</h3>
            <ul class="lines">
              {school.awards.map((award) => (
                <li>{award.title}{award.grade && `: ${award.grade}`}{award.note && `. ${award.note}`}</li>
              ))}
            </ul>
            {school.verifyUrl && <a class="link" href={school.verifyUrl} style="font-size:15px">Verify with City &amp; Guilds</a>}
          </article>
        ))
      }
    </div>
  </section>
</Layout>
