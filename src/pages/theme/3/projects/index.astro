---
import { getPortfolio } from '../../../../lib/content';
import Layout from '../../../../themes/cobalt/Layout.astro';
import ProjectCard from '../../../../themes/cobalt/ProjectCard.astro';

const { projects, otherRepos } = await getPortfolio();
---

<Layout title="Projects">
  <Fragment slot="hero">
    <h1 class="heading">Things I've <em>been building</em></h1>
    <p class="hero-sub" style="margin-block-end:0">Serverless apps, a desktop updater and a pull request pipeline, all public on GitHub.</p>
  </Fragment>

  <section class="section">
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section">
    <h2 class="title">More on GitHub</h2>
    <div class="card-list three" style="margin-block-start:24px">
      {
        otherRepos.map((repo) => (
          <article class="panel">
            <p class="small-meta">{repo.language}</p>
            <h3 style="font-weight:500;margin-block:4px;overflow-wrap:anywhere"><a href={repo.url}>{repo.name}</a></h3>
            <p style="font-size:15px;color:var(--soft)">{repo.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
