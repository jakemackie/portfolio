---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Icon from '../../../../components/Icon.astro';
import LiveRepo from '../../../../components/LiveRepo.astro';
import { getPortfolio, projectPaths, type Project } from '../../../../lib/content';
import Layout from '../../../../themes/cobalt/Layout.astro';

export const getStaticPaths = projectPaths;

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { projects } = await getPortfolio();
const view = projects.find((p) => p.slug === project.id)!;
const next = projects[(projects.indexOf(view) + 1) % projects.length]!;
---

<Layout title={view.title} description={view.tagline}>
  <Fragment slot="hero">
    <span class="chip">{view.platform}, {view.year}</span>
    <h1 class="heading hero-title">{view.title}</h1>
    <p class="hero-sub" style="margin-block-end:0">{view.tagline}</p>
  </Fragment>

  {
    view.images.length > 0 && (
      <div class:list={['section', 'shots', { two: view.images.length > 1 }]} style="padding-block-start:32px">
        {view.images.map((image) => (
          <Image src={image.src} alt={image.alt} widths={[500, 900, 1300]} sizes="(min-width: 760px) 50vw, 100vw" />
        ))}
      </div>
    )
  }

  <section class="section columns">
    <div class="prose"><Content /></div>
    <aside class="panel">
      <dl class="meta">
        <dt>Built with</dt>
        <dd>{view.stack.join(', ')}</dd>
        {
          view.repoData && (
            <>
              <dt>Source</dt>
              <dd><a href={view.repoData.url}>{view.repoData.fullName}</a></dd>
              <dt>On GitHub now</dt>
              <dd><LiveRepo repo={view.repoData} /></dd>
            </>
          )
        }
        {
          view.live && (
            <>
              <dt>Live</dt>
              <dd><a href={view.live}>{new URL(view.live).host}</a></dd>
            </>
          )
        }
      </dl>
    </aside>
  </section>

  <section class="section">
    <div class="services" style="margin:0">
      {view.points.map((point, index) => (
        <article class:list={['service', { on: index === 2 }]}>
          <p>{point}</p>
        </article>
      ))}
    </div>
    <p style="margin-block-start:32px">
      <a class="btn primary" href={`/theme/3/projects/${next.slug}`}><span class="btn-icon"><Icon name="arrow-right" /></span>Next: {next.title}</a>
    </p>
  </section>
</Layout>
