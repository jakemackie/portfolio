---
import Icon from '../../../components/Icon.astro';
import { formatNumber, getPortfolio, monthlyContributions } from '../../../lib/content';
import Layout from '../../../themes/cobalt/Layout.astro';
import ProjectCard from '../../../themes/cobalt/ProjectCard.astro';

const { profile, projects, clients, skills, activity } = await getPortfolio();
const months = await monthlyContributions();
const peak = Math.max(...months.map((month) => month.count));
const tools = ['Figma', 'WordPress', 'Astro', 'Next.js', 'Vue', 'Tailwind CSS', 'Hono', 'Cloudflare Workers', 'D1', 'R2', 'Docker', 'GitHub Actions', 'Vitest', '.NET'];
const frameworks = skills.find((group) => group.label === 'Frameworks');
---

<Layout tall>
  <Fragment slot="hero">
    <span class="chip">{profile.role}, {profile.location}</span>
    <h1 class="heading hero-title">Fast sites, and the blocks that let <em>teams run them</em></h1>
    <p class="hero-sub">Two years shipping production WordPress at an agency, plus my own products on Cloudflare and .NET.</p>
    <a class="btn light" href="/theme/3/contact"><span class="btn-icon"><Icon name="arrow-right" /></span>Get in touch</a>
    <p class="hero-count" style="margin-block-start:auto">25+ client websites shipped or maintained</p>
  </Fragment>

  <section class="section">
    <div class="head-row">
      <h2 class="title">Latest projects I've<br />been working on</h2>
      <a class="btn primary" href="/theme/3/projects"><span class="btn-icon"><Icon name="arrow-right" /></span>All projects</a>
    </div>
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section">
    <div class="about-grid">
      <p class="label">About and services</p>
      <p class="title">I'm a full-stack developer who turns Figma designs into fast, accessible sites, in PHP, JavaScript and Tailwind CSS.</p>
    </div>
    <div class="services">
      <article class="service">
        <span class="service-icon"><Icon name="note" /></span>
        <h3>WordPress builds</h3>
        <p>Custom themes, Gutenberg blocks and flexible content models with Advanced Custom Fields.</p>
      </article>
      <article class="service">
        <span class="service-icon"><Icon name="arrow-up-right" /></span>
        <h3>Web apps</h3>
        <p>{frameworks?.items.slice(0, 5).join(', ')}, from the interface through to the API.</p>
      </article>
      <article class="service on">
        <span class="service-icon"><Icon name="github" /></span>
        <h3>Serverless products</h3>
        <p>Cloudflare Workers, D1 and R2, with versioned migrations, tests and automated releases.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="title center">What you get<br />when we work together</h2>
    <div class="bento">
      <article class="bento-card">
        <h3>Blocks your team can use</h3>
        <p>50+ reusable Gutenberg blocks built, so clients edit pages without a developer.</p>
        <div class="bento-visual">
          <div class="block-grid" aria-hidden="true">
            {Array.from({ length: 50 }, () => <span></span>)}
          </div>
        </div>
      </article>
      <article class="bento-card">
        <h3>Steady delivery</h3>
        <p>{formatNumber(activity.lastYearTotal)} GitHub contributions in the last twelve months.</p>
        <div class="bento-visual" style="flex-direction:column;align-items:stretch;justify-content:flex-end">
          <div class="bars" role="img" aria-label="Contributions per month over the last year">
            {months.map((month) => <span class:list={{ top: month.count === peak }} style={`height:${Math.max(3, (month.count / peak) * 100)}%`} title={`${month.label}: ${month.count}`}></span>)}
          </div>
          <p class="bars-note">Contributions per month, last 12 months</p>
        </div>
      </article>
      <article class="bento-card">
        <h3>Responsive, accessible interfaces</h3>
        <p>Component-based UI that holds up on every screen, handed off cleanly from Figma.</p>
        <div class="bento-visual">
          <div class="screens" aria-hidden="true">
            <span style="width:45%;height:120px"></span>
            <span style="width:28%;height:96px"></span>
            <span style="width:14%;height:72px"></span>
          </div>
        </div>
      </article>
      <article class="bento-card">
        <h3>Reliable releases</h3>
        <p>Git branches, peer code review and GitHub Actions pipelines on production work.</p>
        <div class="bento-visual">
          <div class="nodes" aria-hidden="true">
            <span>Branch</span><i></i><span>Review</span><i></i><span>CI</span><i></i><span class="on">Live</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="title center">The tools I work with</h2>
    <ul class="tools">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <section class="section">
    <h2 class="title center">Sites I've worked on</h2>
    <p class="sub center">Three of the 25+ clients I worked with at Hiyield</p>
    <div class="clients">
      {
        clients.map((client) => (
          <article class="client">
            <small>{client.sector}</small>
            <h3><a href={client.url}>{client.name}</a></h3>
            <p>{client.summary}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
