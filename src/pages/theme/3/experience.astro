---
import { formatRange, getPortfolio, tenure } from '../../../lib/content';
import Layout from '../../../themes/cobalt/Layout.astro';

const { experience, clients } = await getPortfolio();
const lead = experience.find((job) => job.kind === 'engineering')!;
const others = experience.filter((job) => job.kind !== 'engineering');
---

<Layout title="Experience">
  <Fragment slot="hero">
    <h1 class="heading">Where I've <em>been working</em></h1>
    <p class="hero-sub" style="margin-block-end:0">{lead.summary}</p>
  </Fragment>

  <section class="section columns">
    <div>
      <p class="small-meta">{formatRange(lead.start, lead.end)}, {tenure(lead.start, lead.end)}</p>
      <h2 class="title" style="margin-block:4px">{lead.company}</h2>
      <p style="color:var(--soft);margin-block-end:24px">{lead.role}</p>
      <ul class="lines">
        {lead.highlights.map((point) => <li style="font-size:17px">{point}</li>)}
      </ul>
    </div>
    <aside class="panel">
      <p class="small-meta">Team</p>
      <p>{lead.context}</p>
      <p class="small-meta" style="margin-block-start:16px">Where</p>
      <p>{lead.location}</p>
      <p class="small-meta" style="margin-block-start:16px">Stack</p>
      <p>{lead.stack.join(', ')}</p>
    </aside>
  </section>

  <section class="section">
    <h2 class="title center">Sites I've worked on</h2>
    <p class="sub center">Three of the 25+ clients I worked with at Hiyield</p>
    <div class="clients">
      {
        clients.map((client) => (
          <article class="client">
            <small>{client.sector}</small>
            <h3><a href={client.url}>{client.name}</a></h3>
            <p>{client.summary}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="title">Earlier</h2>
    <div class="card-list three" style="margin-block-start:24px">
      {
        others.map((job) => (
          <article class="panel">
            <p class="small-meta">{formatRange(job.start, job.end)}</p>
            <h3 style="font-weight:500;margin-block:4px">{job.company}</h3>
            <p style="font-size:15px">{job.role}</p>
            <p style="font-size:15px;color:var(--soft);margin-block-start:8px">{job.summary}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
