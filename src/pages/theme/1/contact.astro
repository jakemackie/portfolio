---
import { getPortfolio } from '../../../lib/content';
import Layout from '../../../themes/swiss/Layout.astro';

const { profile } = await getPortfolio();
---

<Layout title="Contact">
  <section class="contact">
    <h1 class="display">Get in<br />touch</h1>
    <div>
      <p class="caps" style="margin-block-end:16px;max-inline-size:40ch">{profile.availability}</p>
      <a class="contact-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      <ul style="display:flex;gap:20px;margin-block-start:24px">
        {profile.links.map((link) => <li><a href={link.url} style="text-decoration:underline;text-underline-offset:3px">{link.label}</a></li>)}
      </ul>
    </div>
  </section>
</Layout>
