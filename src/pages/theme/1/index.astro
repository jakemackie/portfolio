---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import { formatRange, formatStat, getPortfolio } from '../../../lib/content';
import Layout from '../../../themes/swiss/Layout.astro';

const { profile, highlights, projects, experience, clients } = await getPortfolio();
const shot = projects.find((project) => project.slug === 'reskate-trainer-updater')?.images[1];
const roles = experience.filter((job) => job.kind !== 'earlier');
---

<Layout>
  <section class="hero">
    <h1 class="display">Full-stack<br />developer</h1>
    {
      shot && (
        <div class="hero-image">
          <Image src={shot.src} alt={shot.alt} widths={[400, 700, 1000]} sizes="(min-width: 760px) 33vw, 100vw" loading="eager" />
        </div>
      )
    }
    <div class="hero-foot">
      <div class="hero-note">
        <a href="#work" aria-label="Skip to selected work"><Icon name="arrow-down" size={48} stroke={1.75} /></a>
        <p class="caps">I build fast, accessible sites and the blocks that let teams run them</p>
      </div>
      <p class="display hero-name">Jake<br />Mackie</p>
    </div>
  </section>

  <section class="section" id="work">
    <div class="section-head">
      <h2>Selected work</h2>
      <a href="/theme/1/projects">All projects</a>
    </div>
    <div class="rows">
      {
        projects.map((project) => (
          <a class="row" href={`/theme/1/projects/${project.slug}`}>
            <span class="display sm wide">{project.title}</span>
            <small>{project.platform}</small>
            <small class="end">{project.year}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <ul class="stats">
      {
        highlights.map((highlight) => (
          <li>
            <p class="stat-value">{formatStat(highlight)}</p>
            <p class="stat-label">{highlight.label}</p>
            <p class="stat-detail">{highlight.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section split">
    <h2 class="side" style="font-size:14px">About</h2>
    <div class="main">
      <p class="lead">{profile.intro}</p>
      <p style="margin-block-start:24px"><a href="/theme/1/about">More about me</a></p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Experience</h2>
      <a href="/theme/1/experience">Full history</a>
    </div>
    <div class="rows">
      {
        roles.map((job) => (
          <div class="row">
            <span class="display sm wide">{job.company}</span>
            <small>{job.role}</small>
            <small class="end">{formatRange(job.start, job.end)}</small>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected clients</h2>
      <span>3 of 25+</span>
    </div>
    <div class="rows">
      {
        clients.map((client) => (
          <a class="row" href={client.url}>
            <span class="display sm wide">{client.name}</span>
            <small>{client.sector}</small>
            <small class="end">{client.domain}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <a class="cta" href="/theme/1/contact"><span class="display">Get in<br />touch</span></a>
  </section>
</Layout>
