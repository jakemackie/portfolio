---
import { formatRange, getPortfolio, tenure } from '../../../lib/content';
import Layout from '../../../themes/swiss/Layout.astro';

const { experience, clients } = await getPortfolio();
const lead = experience.find((job) => job.kind === 'engineering')!;
const others = experience.filter((job) => job.kind !== 'engineering');
---

<Layout title="Experience">
  <div class="page-head">
    <h1 class="display">Experience</h1>
  </div>

  <section class="section split">
    <dl class="side meta">
      <dt>Dates</dt>
      <dd>{formatRange(lead.start, lead.end)}</dd>
      <dt>Length</dt>
      <dd>{tenure(lead.start, lead.end)}</dd>
      <dt>Where</dt>
      <dd>{lead.location}</dd>
    </dl>
    <div class="main">
      <h2 class="display md">{lead.company}</h2>
      <p class="caps" style="margin-block:16px 24px">{lead.role}</p>
      <p class="lead" style="font-size:clamp(1.5rem,2.8vw,2.75rem);max-inline-size:28ch">{lead.summary}</p>
      <ul class="list-lines body-text" style="margin-block-start:32px">
        {lead.highlights.map((point) => <li>{point}</li>)}
      </ul>
      <p style="margin-block-start:16px;color:var(--soft)">{lead.stack.join(', ')}</p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected clients</h2>
      <span>3 of 25+</span>
    </div>
    <div class="rows">
      {
        clients.map((client) => (
          <a class="row" href={client.url}>
            <span class="display sm">{client.name}</span>
            <small style="grid-column:2/4">{client.summary}</small>
            <small class="end">{client.sector}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Earlier</h2></div>
    <div class="rows">
      {
        others.map((job) => (
          <div class="row">
            <span class="display sm">{job.company}</span>
            <small style="grid-column:2/4">{job.role}. {job.summary}</small>
            <small class="end">{formatRange(job.start, job.end)}</small>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
