---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import LiveRepo from '../../../../components/LiveRepo.astro';
import { getPortfolio, projectPaths, type Project } from '../../../../lib/content';
import Layout from '../../../../themes/swiss/Layout.astro';

export const getStaticPaths = projectPaths;

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { projects } = await getPortfolio();
const view = projects.find((p) => p.slug === project.id)!;
const next = projects[(projects.indexOf(view) + 1) % projects.length]!;
---

<Layout title={view.title} description={view.tagline}>
  <div class="page-head">
    <h1 class="display md">{view.title}</h1>
    <p class="lead" style="margin-block-start:24px">{view.tagline}</p>
  </div>

  {
    view.images.length > 0 && (
      <div class="section image-pair" style="padding-block-start:clamp(32px,4vw,48px)">
        {view.images.map((image) => (
          <Image src={image.src} alt={image.alt} widths={[500, 900, 1300]} sizes="(min-width: 760px) 50vw, 100vw" />
        ))}
      </div>
    )
  }

  <section class="section split">
    <dl class="side meta">
      <dt>Type</dt>
      <dd>{view.platform}, {view.year}</dd>
      <dt>Built with</dt>
      <dd>{view.stack.join(', ')}</dd>
      {
        view.repoData && (
          <>
            <dt>Source</dt>
            <dd><a href={view.repoData.url} style="text-decoration:underline">{view.repoData.fullName}</a></dd>
            <dt>On GitHub now</dt>
            <dd><LiveRepo repo={view.repoData} /></dd>
          </>
        )
      }
      {
        view.live && (
          <>
            <dt>Live</dt>
            <dd><a href={view.live} style="text-decoration:underline">{new URL(view.live).host}</a></dd>
          </>
        )
      }
    </dl>
    <div class="main prose"><Content /></div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Highlights</h2></div>
    <div class="rows">
      {view.points.map((point, index) => (
        <div class="row">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <span style="grid-column:2/-1">{point}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <p style="font-size:14px;margin-block-end:12px">Next project</p>
    <a class="cta" href={`/theme/1/projects/${next.slug}`}><span class="display md">{next.title}</span></a>
  </section>
</Layout>
