---
import { Image } from 'astro:assets';
import { getPortfolio } from '../../../../lib/content';
import Layout from '../../../../themes/swiss/Layout.astro';

const { projects, otherRepos } = await getPortfolio();
const withImages = projects.filter((project) => project.images.length > 0);
const withoutImages = projects.filter((project) => project.images.length === 0);
---

<Layout title="Projects">
  <div class="page-head">
    <h1 class="display">Projects</h1>
  </div>

  <section class="section image-pair">
    {
      withImages.map((project) => (
        <article>
          <a href={`/theme/1/projects/${project.slug}`} aria-label={project.title}>
            <Image src={project.images.at(-1)!.src} alt={project.images.at(-1)!.alt} widths={[500, 900, 1300]} sizes="(min-width: 760px) 50vw, 100vw" style="aspect-ratio:16/10;object-fit:cover" />
          </a>
          <h2 class="display sm" style="margin-block-start:16px"><a href={`/theme/1/projects/${project.slug}`}>{project.title}</a></h2>
          <p style="margin-block-start:8px;max-inline-size:44ch">{project.tagline}</p>
          <p style="margin-block-start:4px;color:var(--soft);font-size:14px">{project.stack.join(', ')}</p>
        </article>
      ))
    }
  </section>

  <section class="section">
    <div class="rows">
      {
        withoutImages.map((project) => (
          <a class="row" href={`/theme/1/projects/${project.slug}`}>
            <span class="display sm wide">{project.title}</span>
            <small>{project.tagline}</small>
            <small class="end">{project.year}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>More on GitHub</h2></div>
    <div class="rows">
      {
        otherRepos.map((repo) => (
          <a class="row" href={repo.url}>
            <span>{repo.name}</span>
            <small style="grid-column:2/4">{repo.description}</small>
            <small class="end">{repo.language}</small>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
