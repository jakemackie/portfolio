---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import LiveRepo from '../../../../components/LiveRepo.astro';
import { getPortfolio, projectPaths, type Project } from '../../../../lib/content';
import Layout from '../../../../themes/heat/Layout.astro';

export const getStaticPaths = projectPaths;

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { projects } = await getPortfolio();
const view = projects.find((p) => p.slug === project.id)!;
const next = projects[(projects.indexOf(view) + 1) % projects.length]!;
---

<Layout title={view.title} description={view.tagline} heading={view.title}>
  <section class="section">
    <p class="statement">{view.tagline}</p>
  </section>

  {
    view.images.length > 0 && (
      <div class="section shots" style="padding-block-start:40px">
        {view.images.map((image) => (
          <Image src={image.src} alt={image.alt} widths={[500, 900, 1300]} sizes="(min-width: 760px) 50vw, 100vw" />
        ))}
      </div>
    )
  }

  <section class="section two">
    <dl class="meta">
      <dt>Type</dt>
      <dd>{view.platform}, {view.year}</dd>
      <dt>Built with</dt>
      <dd>{view.stack.join(', ')}</dd>
      {
        view.repoData && (
          <>
            <dt>Source</dt>
            <dd><a href={view.repoData.url}>{view.repoData.fullName}</a></dd>
            <dt>On GitHub now</dt>
            <dd><LiveRepo repo={view.repoData} /></dd>
          </>
        )
      }
      {
        view.live && (
          <>
            <dt>Live</dt>
            <dd><a href={view.live}>{new URL(view.live).host}</a></dd>
          </>
        )
      }
    </dl>
    <div>
      <div class="prose"><Content /></div>
      <ul class="lines" style="margin-block-start:32px;max-inline-size:62ch">
        {view.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <a class="closing" href={`/theme/2/projects/${next.slug}`}>
    <p>Next project</p>
    <strong>{next.title}</strong>
  </a>
</Layout>
