---
import { getPortfolio } from '../../../../lib/content';
import Layout from '../../../../themes/heat/Layout.astro';

const { projects, otherRepos } = await getPortfolio();
---

<Layout title="Projects" heading="Projects">
  <section class="section">
    <div class="big-rows">
      {
        projects.map((project) => (
          <a class="big-row" href={`/theme/2/projects/${project.slug}`}>
            <span class="big-row-title">{project.title}</span>
            <span class="big-row-meta">{project.platform}, {project.year}</span>
            <span class="big-row-tag">{project.tagline}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="eyebrow">More on GitHub</h2>
    <div class="big-rows">
      {
        otherRepos.map((repo) => (
          <a class="big-row" href={repo.url}>
            <span class="big-row-title sm" style="overflow-wrap:anywhere">{repo.name}</span>
            <span class="big-row-meta">{repo.language}</span>
            <span class="big-row-tag">{repo.description}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
