---
import Icon from '../../../components/Icon.astro';
import { getPortfolio } from '../../../lib/content';
import Layout from '../../../themes/noir/Layout.astro';

const { profile } = await getPortfolio();
---

<Layout title="Contact">
  <Fragment slot="stage">
    <h1 class="title"><strong>Let's</strong> chat</h1>
    <p class="title-sub">{profile.availability}</p>
    <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
  </Fragment>

  <section class="section">
    <h2 class="h">Elsewhere</h2>
    <p class="h-sub">Find me online</p>
    {
      profile.links.map((link) => (
        <a class="card" href={link.url}>
          <strong>{link.label}</strong>
          <span class="desc">{link.handle}</span>
          <Icon name="arrow-up-right" />
        </a>
      ))
    }
  </section>
</Layout>
