---
import Icon from '../components/Icon.astro';
import { getPortfolio } from '../lib/content';
import { personRef } from '../lib/seo';
import Layout from '../layouts/Layout.astro';

const { profile } = await getPortfolio();
const schema = [{ '@type': 'ContactPage', url: new URL('/contact', Astro.site).href, mainEntity: personRef(Astro.site!) }];
---

<Layout
  title="Contact a Full-Stack Developer in Cornwall"
  description="Get in touch with Jake Mackie, a full-stack developer based in Penzance, Cornwall, and open to on-site, hybrid or remote work. Email, GitHub and LinkedIn."
  heading="Let's chat"
  blurb="Open to work: on-site, hybrid or remote."
  bareFoot
  {schema}
>
  <section class="section" style="padding-block-end:clamp(32px,6vw,72px)">
    <p class="eyebrow">{profile.availability}</p>
    <a class="contact-big" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div>
      <button class="pill on-dark copy-email" type="button" data-email={profile.email}>
        <span aria-live="polite">Copy email</span>
        <Icon name="copy" class="copy-idle" />
        <Icon name="check" class="copy-done" />
      </button>
    </div>
    <ul style="display:flex;gap:20px;margin-block-start:32px">
      {profile.links.map((link) => <li><a class="link" href={link.url}>{link.label}</a></li>)}
    </ul>
  </section>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('.copy-email')!;
  const label = button.querySelector('span')!;
  let timer = 0;

  button.addEventListener('click', async () => {
    let copied = false;
    try {
      await navigator.clipboard.writeText(button.dataset.email!);
      copied = true;
    } catch {}
    button.toggleAttribute('data-copied', copied);
    label.textContent = copied ? 'Copied' : "Couldn't copy";
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      button.removeAttribute('data-copied');
      label.textContent = 'Copy email';
    }, 2000);
  });
</script>
