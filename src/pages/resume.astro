---
import Icon from '../components/Icon.astro';
import { formatStat, getPortfolio } from '../lib/content';
import Layout from '../layouts/Layout.astro';

const { profile, highlights } = await getPortfolio();
const file = '/jake-mackie-cv.pdf';
---

<Layout
  title="Resume: Full-Stack Developer in Cornwall"
  description="The CV of Jake Mackie, a full-stack developer in Penzance, Cornwall, with agency WordPress experience and a Level 4 Distinction. Read or download the PDF."
  heading="Resume"
  blurb="My CV as a PDF, to read in your browser or download."
>
  <section class="section">
    <p class="statement">{profile.summary}</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;margin-block-start:8px">
      <a class="pill on-dark" href={file} download={`${profile.name} - CV.pdf`}>Download PDF <Icon name="arrow-down" /></a>
      <a class="pill on-dark" href={file} target="_blank" rel="noopener">Open in browser <Icon name="arrow-up-right" /></a>
    </div>
  </section>

  <section class="section" style="padding-block-end:clamp(32px,6vw,72px)">
    <ul class="stats">
      {
        highlights.map((highlight) => (
          <li class="reveal">
            <p class="stat-value">{formatStat(highlight)}</p>
            <p class="stat-label">{highlight.label}</p>
            <p class="stat-detail">{highlight.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
