---
import { render } from 'astro:content';
import Gallery from '../../components/Gallery.astro';
import LiveRepo from '../../components/LiveRepo.astro';
import Stars from '../../components/Stars.astro';
import { getPortfolio, projectPaths, type Project } from '../../lib/content';
import { breadcrumbSchema, personRef } from '../../lib/seo';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = projectPaths;

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { projects } = await getPortfolio();
const view = projects.find((p) => p.slug === project.id)!;
const next = projects[(projects.indexOf(view) + 1) % projects.length]!;

const site = Astro.site!;
const path = `/projects/${view.slug}`;
const schema = [
  {
    '@type': 'SoftwareSourceCode',
    name: view.title,
    description: view.description,
    url: new URL(path, site).href,
    author: personRef(site),
    dateCreated: String(view.year),
    keywords: view.stack,
    ...(view.repoData && { codeRepository: view.repoData.url, programmingLanguage: view.repoData.language }),
  },
  breadcrumbSchema(site, [
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' },
    { name: view.title, path },
  ]),
];
---

<Layout
  title={`${view.title}: ${view.platform}`}
  description={view.description}
  heading={view.title}
  blurb={view.tagline}
  {schema}
>
  <section class="section two">
    <dl class="meta">
      <dt>Type</dt>
      <dd>{view.platform}, {view.year}</dd>
      <dt>Built with</dt>
      <dd>{view.stack.join(', ')}</dd>
      {
        view.repoData && (
          <>
            <dt>Source</dt>
            <dd><a href={view.repoData.url}>{view.repoData.fullName}</a></dd>
            <dt>On GitHub now</dt>
            <dd><LiveRepo repo={view.repoData} /></dd>
          </>
        )
      }
      {
        view.live && (
          <>
            <dt>Live</dt>
            <dd><a href={view.live}>{new URL(view.live).host}</a></dd>
          </>
        )
      }
    </dl>
    <div>
      <p class="statement" style="font-size:clamp(1.5rem,2.8vw,2.75rem);max-inline-size:32ch">{view.tagline}</p>
      {
        view.images.length > 0 && (
          <div style="margin-block-start:32px">
            <Gallery title={view.title} images={view.images} />
          </div>
        )
      }
      <div class="prose" style="margin-block-start:48px"><Content /></div>
      <ul class="lines" style="margin-block-start:32px;max-inline-size:62ch">
        {view.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <a class="closing" href={`/projects/${next.slug}`}>
    <Stars count={18} />
    <p>Next project</p>
    <strong>{next.title}</strong>
  </a>
</Layout>
