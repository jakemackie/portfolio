---
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import { getPortfolio, siteNav } from '../lib/content';
import { pagePath } from '../lib/seo';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  /** Big word at the foot of the gradient band. */
  heading?: string;
  /** One short line under the heading. */
  blurb?: string;
  /** Skip the email and social links in the footer, for pages that already show them. */
  bareFoot?: boolean;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, heading, blurb, bareFoot, noindex, schema } = Astro.props;
const { profile } = await getPortfolio();
const nav = siteNav(Astro.url.pathname);
// The section this page is in or under, shown after the name in the header.
const section = nav.find((link) => link.active);
const isHome = pagePath(Astro.url.pathname) === '/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead {title} {description} {noindex} {schema} themeColor="#e5401c" colorScheme="dark" />
    <Font cssVariable="--font-geist" preload />
    <script is:inline>
      document.documentElement.classList.add('js');

      // The clock and the sky follow the time in London, wherever the visitor is. Asking for the
      // Europe/London zone leaves the switch between GMT and BST to the browser's time zone data.
      {
        const NIGHT_FROM = 19;
        const NIGHT_UNTIL = 7;
        const SKY_COLOURS = { day: '#e5401c', night: '#040614' };
        const root = document.documentElement;
        const format = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
          timeZoneName: 'short',
        });
        const calm = matchMedia('(prefers-reduced-motion: reduce)');

        const setSky = (sky) => {
          root.dataset.sky = sky;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', SKY_COLOURS[sky]);
          const icon = document.querySelector('link[rel="icon"]');
          const href = sky === 'night' ? '/favicon-night.svg' : '/favicon.svg';
          if (icon && icon.getAttribute('href') !== href) icon.setAttribute('href', href);
        };

        // How far the device's clock is from the server's, so a wrong clock can't show the wrong time.
        // Remembered for the visit, so only the first page asks.
        let drift = null;
        try {
          const saved = sessionStorage.getItem('clock-drift');
          if (saved !== null) drift = Number(saved) || 0;
        } catch {}

        const checkDrift = async () => {
          if (drift !== null) return;
          try {
            const response = await fetch(location.href, { method: 'HEAD', cache: 'no-store' });
            const date = Date.parse(response.headers.get('date'));
            // An Age header means a cache may have kept an old Date.
            if (Number.isNaN(date) || response.headers.has('age')) return;
            const gap = date - Date.now();
            // The header is only accurate to the second, so leave clocks that are nearly right alone.
            drift = Math.abs(gap) > 30000 ? gap : 0;
            sessionStorage.setItem('clock-drift', String(drift));
            tick();
          } catch {}
        };

        const tick = () => {
          const now = new Date(Date.now() + (drift ?? 0));
          const parts = Object.fromEntries(format.formatToParts(now).map((part) => [part.type, part.value]));
          const hour = Number(parts.hour);
          const sky = hour >= NIGHT_FROM || hour < NIGHT_UNTIL ? 'night' : 'day';

          const time = document.querySelector('.clock-time');
          if (time) {
            const text = `${parts.hour}:${parts.minute}`;
            if (time.textContent !== text) time.textContent = text;
            const zone = document.querySelector('.clock-zone');
            if (zone.textContent !== parts.timeZoneName) zone.textContent = parts.timeZoneName;
          }

          if (root.dataset.sky === sky) return;
          // Only a change while the page is open animates: dusk and dawn open outwards from the clock.
          const clock = document.querySelector('.clock');
          if (root.dataset.sky && clock && document.startViewTransition && !calm.matches && !document.hidden) {
            const r = clock.getBoundingClientRect();
            root.style.setProperty('--vt-origin', `${Math.round(r.left + r.width / 2)}px ${Math.round(r.top + r.height / 2)}px`);
            document.startViewTransition(() => setSky(sky));
          } else {
            setSky(sky);
          }
        };

        tick();
        addEventListener('DOMContentLoaded', tick);
        addEventListener('load', checkDrift);
        setInterval(tick, 1000);
      }

      // Remember where the visitor clicked so the next page can open outwards from that point.
      document.addEventListener('click', (e) => {
        const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
        if (!a || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (a.target || a.hasAttribute('download') || a.origin !== location.origin || a.pathname === location.pathname) return;
        const r = a.getBoundingClientRect();
        const x = e.detail ? e.clientX : r.left + r.width / 2;
        const y = e.detail ? e.clientY : r.top + r.height / 2;
        try {
          sessionStorage.setItem('vt-origin', Math.round(x) + 'px ' + Math.round(y) + 'px');
        } catch {}
      });

      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        try {
          const origin = sessionStorage.getItem('vt-origin');
          sessionStorage.removeItem('vt-origin');
          if (origin) document.documentElement.style.setProperty('--vt-origin', origin);
        } catch {}
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <p class="clock" title={`My local time in ${profile.location}`}>
      <span class="clock-mood" aria-hidden="true"><Icon name="sun" stroke={2} /><i>z</i><i>z</i><i>z</i></span>
      <span class="clock-time"></span> <span class="clock-zone"></span>
    </p>
    <button class="burger" type="button" aria-expanded="false" aria-controls="menu">
      <span class="burger-label" data-open="Menu" data-close="Close"></span>
      <span class="burger-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
    <div class="menu" id="menu" role="dialog" aria-label="Site menu" inert>
      <nav aria-label="Main">
        <ul>
          <li style="--i:0"><a href="/" aria-current={isHome ? 'page' : undefined}><span class="menu-num">00</span><span class="menu-text">Home</span></a></li>
          {nav.map((link, i) => (
            <li style={`--i:${i + 1}`}><a href={link.href} aria-current={link.active ? 'page' : undefined}><span class="menu-num">{String(i + 1).padStart(2, '0')}</span><span class="menu-text">{link.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <div class="menu-foot">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <ul>
          {profile.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class:list={['band', heading ? 'short' : 'full']}>
      <Stars />
      <header class="top">
        <a class="logo" href="/">{profile.name}</a>
        {section && <a class="crumb" href={section.href}>/ {section.label}</a>}
      </header>
      <slot name="band" />
      {
        heading && (
          <h1 class="band-heading" aria-label={heading}>
            {heading.split(' ').map((word, i) => (
              <>
                <span class="word" aria-hidden="true" style={`--w:${i}`}>{word}</span>{' '}
              </>
            ))}
          </h1>
        )
      }
      {heading && blurb && <p class="band-blurb">{blurb}</p>}
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      {
        bareFoot ? (
          <span>{profile.name}, {profile.location}</span>
        ) : (
          <>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <ul>
              {profile.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
            </ul>
          </>
        )
      }
    </footer>
    <script>
      const burger = document.querySelector<HTMLButtonElement>('.burger')!;
      const menu = document.querySelector<HTMLElement>('.menu')!;
      const label = burger.querySelector<HTMLElement>('.burger-label')!;
      const setOpen = (open: boolean) => {
        burger.setAttribute('aria-expanded', String(open));
        document.documentElement.toggleAttribute('data-menu', open);
        menu.inert = !open;
        if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      };
      burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a');
        if (!link) return;
        // Leave the menu open when navigating away so the page transition starts from it.
        const leaving = link.origin === location.origin && link.pathname !== location.pathname;
        if (!leaving) setOpen(false);
      });
      addEventListener('pageshow', (e) => {
        if (e.persisted) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          burger.focus();
        }
      });
      label.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-label', 'Menu');

      // Scroll reveals and stat count-ups.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.classList.add('in');
              io.unobserve(el);
              const value = el.querySelector<HTMLElement>('.stat-value');
              if (value) countUp(value);
            }
          },
          { threshold: 0.2 },
        );
        targets.forEach((el) => io.observe(el));
      }

      function countUp(el: HTMLElement) {
        const text = el.textContent ?? '';
        const match = text.match(/[\d,]+/);
        if (!match) return;
        const end = Number(match[0].replace(/,/g, ''));
        const [before, after] = text.split(match[0]);
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / 1400, 1);
          const eased = 1 - Math.pow(1 - t, 4);
          el.textContent = `${before}${Math.round(end * eased).toLocaleString('en-GB')}${after}`;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>
