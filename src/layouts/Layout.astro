---
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import { getPortfolio, siteNav } from '../lib/content';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  /** Big word at the foot of the gradient band. */
  heading?: string;
}

const { title, description, heading } = Astro.props;
const { profile } = await getPortfolio();
const nav = siteNav(Astro.url.pathname).filter((link) => link.label !== 'Home');
const links = nav.filter((link) => link.label !== 'Contact');
const contact = nav.find((link) => link.label === 'Contact')!;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead {title} {description} themeColor="#e5401c" colorScheme="dark" />
    <Font cssVariable="--font-geist" preload />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['band', heading ? 'short' : 'full']}>
      <header class="top">
        <a class="logo" href="/">{profile.name}</a>
        <nav aria-label="Main">
          <ul>
            {links.map((link) => <li><a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a></li>)}
            <li><a class="chat" href={contact.href} aria-current={contact.active ? 'page' : undefined}>Let's chat</a></li>
          </ul>
        </nav>
      </header>
      <slot name="band" />
      {heading && <h1 class="band-heading">{heading}</h1>}
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <ul>
        {profile.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
      </ul>
    </footer>
  </body>
</html>
