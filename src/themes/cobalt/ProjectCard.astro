---
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import type { getPortfolio } from '../../lib/content';

type View = Awaited<ReturnType<typeof getPortfolio>>['projects'][number];

interface Props {
  project: View;
}

const { project } = Astro.props;
const image = project.images[0];
const href = `/theme/3/projects/${project.slug}`;
---

<article class="project">
  <a class="project-cover" href={href} aria-label={project.title}>
    {
      image ? (
        <Image src={image.src} alt={image.alt} widths={[500, 900]} sizes="(min-width: 760px) 50vw, 100vw" />
      ) : (
        <span class="cover-word" aria-hidden="true">{project.title}</span>
      )
    }
  </a>
  <h3>{project.title}</h3>
  <p>{project.tagline}</p>
  <a class="btn-mini" href={href}>Read case study <Icon name="arrow-right" size={14} /></a>
</article>
