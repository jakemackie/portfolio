---
import { Font } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Icon from '../../components/Icon.astro';
import ThemeBar from '../../components/ThemeBar.astro';
import { getPortfolio, themeNav } from '../../lib/content';
import './theme.css';

interface Props {
  title?: string;
  description?: string;
  /** Full-height hero on the home page, shorter everywhere else. */
  tall?: boolean;
}

const { title, description, tall = false } = Astro.props;
const { profile } = await getPortfolio();
const nav = themeNav('3', Astro.url.pathname).filter((link) => link.label !== 'Home' && link.label !== 'Contact');
const [firstName, ...others] = profile.name.split(' ');
const marquee = `${profile.name.toLowerCase()} `.repeat(4);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead {title} {description} themeColor="#04102f" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-instrument" preload />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['hero', { tall }]}>
      <header class="top">
        <a class="brand" href="/theme/3">
          <span>{firstName} {others.join(' ')}</span>
          <span class="status"><i aria-hidden="true"></i>Available now</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((link) => <li><a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a></li>)}
          </ul>
        </nav>
        <a class="btn ghost" href="/theme/3/contact"><Icon name="mail" />Get in touch</a>
      </header>
      <div class="hero-body">
        <slot name="hero" />
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    <section class="closing">
      <h2 class="heading">Turn your idea into <em>a live site</em></h2>
      <p>{profile.availability}</p>
      <a class="btn light" href="/theme/3/contact"><span class="btn-icon"><Icon name="arrow-right" /></span>Get in touch</a>
    </section>
    <footer class="foot">
      <div class="foot-row">
        <a class="brand dark" href="/theme/3">
          <span>{profile.name}</span>
          <span class="status"><i aria-hidden="true"></i>Available now</span>
        </a>
        <ul class="foot-nav">
          {nav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <ul class="socials">
          {profile.links.map((link) => (
            <li><a href={link.url} aria-label={link.label}><Icon name={link.label === 'GitHub' ? 'github' : 'linkedin'} /></a></li>
          ))}
          <li><a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" /></a></li>
        </ul>
      </div>
      <p class="marquee" aria-hidden="true">{marquee}</p>
    </footer>
    <ThemeBar />
  </body>
</html>
