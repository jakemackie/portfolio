---
import { Font } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Icon from '../../components/Icon.astro';
import ThemeBar from '../../components/ThemeBar.astro';
import { getPortfolio, themeNav } from '../../lib/content';
import './theme.css';

interface Props {
  title?: string;
  description?: string;
  /** The tall first screen with the orb, used on the home page. */
  tall?: boolean;
}

const { title, description, tall = false } = Astro.props;
const { profile } = await getPortfolio();
const nav = themeNav('4', Astro.url.pathname);
const icon = (label: string) => (label === 'GitHub' ? 'github' : 'linkedin');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead {title} {description} themeColor="#060606" colorScheme="dark" />
    <Font cssVariable="--font-space" preload />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['stage', { tall }]}>
      <div class="orb" aria-hidden="true"></div>
      <header class="top wrap">
        <div class="pill-nav">
          <a class="logo" href="/theme/4">jake.</a>
          <a class="chat" href="/theme/4/contact">Let's chat <Icon name="arrow-up-right" size={14} /></a>
          <details class="menu">
            <summary aria-label="Menu"><Icon name="menu" size={18} /></summary>
            <nav aria-label="Main">
              <ul>
                {nav.map((link) => <li><a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a></li>)}
              </ul>
            </nav>
          </details>
        </div>
        <ul class="socials">
          {profile.links.map((link) => <li><a href={link.url}><Icon name={icon(link.label)} />{link.label}</a></li>)}
          <li><a href={`mailto:${profile.email}`}><Icon name="mail" />Email</a></li>
        </ul>
      </header>
      <div class="stage-body wrap">
        <slot name="stage" />
      </div>
    </div>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="foot wrap">
      <p>{profile.name}, {profile.location}</p>
      <p>Built with Astro on Cloudflare Workers</p>
    </footer>
    <ThemeBar />
  </body>
</html>
