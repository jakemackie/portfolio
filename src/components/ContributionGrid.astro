---
// Real GitHub contribution data. Colours come from --cg-0 to --cg-4 on the theme.
import { formatNumber, getPortfolio } from '../lib/content';

interface Props {
  class?: string;
  cell?: number;
  gap?: number;
}

const { cell = 11, gap = 3, class: className } = Astro.props;
const { activity } = await getPortfolio();
const step = cell + gap;
const labelHeight = 16;

const level = (count: number) => (count === 0 ? 0 : count < 4 ? 1 : count < 10 ? 2 : count < 20 ? 3 : 4);
const month = new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: 'UTC' });

// Label the first full week of each month, skipping any that would crowd the start.
const labels = activity.weeks.flatMap((week, x) => {
  const first = week[0]?.date;
  if (!first || first.getUTCDate() > 7 || x > activity.weeks.length - 3) return [];
  return [{ x, text: month.format(first) }];
});

const width = activity.weeks.length * step - gap;
const height = 7 * step - gap + labelHeight;
---

<svg
  class:list={['contribution-grid', className]}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={`GitHub contribution graph: ${formatNumber(activity.lastYearTotal)} contributions in the last year.`}
>
  {labels.map(({ x, text }) => <text x={x * step} y="10">{text}</text>)}
  {
    activity.weeks.map((week, x) =>
      week.map((day) => (
        <rect
          x={x * step}
          y={day.date.getUTCDay() * step + labelHeight}
          width={cell}
          height={cell}
          rx="2"
          data-level={level(day.count)}
        >
          <title>
            {day.count} on {day.date.toISOString().slice(0, 10)}
          </title>
        </rect>
      )),
    )
  }
</svg>

<style>
  .contribution-grid {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  text {
    font: 10px/1 inherit;
    font-family: inherit;
    fill: currentColor;
    opacity: 0.7;
  }
  rect[data-level='0'] {
    fill: var(--cg-0);
  }
  rect[data-level='1'] {
    fill: var(--cg-1);
  }
  rect[data-level='2'] {
    fill: var(--cg-2);
  }
  rect[data-level='3'] {
    fill: var(--cg-3);
  }
  rect[data-level='4'] {
    fill: var(--cg-4);
  }
</style>
