---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  /** Names the set, in the modal header. */
  title: string;
  images: { src: ImageMetadata; alt: string }[];
}

const { title, images } = Astro.props;
---

<div class="gallery" data-gallery>
  <button class="gallery-stack" type="button" style={`--n:${images.length}`} aria-haspopup="dialog" aria-label={`View ${images.length} screenshots of ${title}`}>
    {
      images.map((image, i) => (
        <span class="gallery-card" style={`--i:${i}`}>
          <Image src={image.src} alt="" widths={[500, 900, 1240]} sizes="(min-width: 860px) 600px, 88vw" />
          {i === 0 && <span class="gallery-hint"><Icon name="arrow-up-right" /></span>}
        </span>
      ))
    }
  </button>

  <dialog class="gallery-modal" aria-label={`${title} screenshots`}>
    <header class="gallery-top">
      <p>{title}</p>
      <button class="gallery-button" type="button" data-close aria-label="Close"><Icon name="close" size={20} /></button>
    </header>
    <div class="gallery-track" tabindex="0">
      {
        images.map((image) => (
          <figure class="gallery-slide">
            <Image src={image.src} alt="" widths={[900, 1300, image.src.width]} sizes="(min-width: 1040px) 960px, 100vw" />
            <figcaption>{image.alt}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="gallery-nav">
      <button class="gallery-button" type="button" data-step="-1" aria-label="Previous screenshot"><Icon name="arrow-right" size={20} class="flip" /></button>
      <span class="gallery-count" aria-live="polite"></span>
      <button class="gallery-button" type="button" data-step="1" aria-label="Next screenshot"><Icon name="arrow-right" size={20} /></button>
    </div>
  </dialog>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector('dialog')!;
    const track = gallery.querySelector<HTMLElement>('.gallery-track')!;
    const count = gallery.querySelector<HTMLElement>('.gallery-count')!;
    const total = track.children.length;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const show = () => (count.textContent = `${current() + 1} of ${total}`);
    const go = (index: number, behavior: ScrollBehavior = reduce ? 'auto' : 'smooth') =>
      track.scrollTo({ left: ((index + total) % total) * track.clientWidth, behavior });

    gallery.querySelector('.gallery-stack')!.addEventListener('click', () => {
      dialog.showModal();
      go(0, 'instant');
      show();
    });

    track.addEventListener('scroll', show, { passive: true });
    gallery.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    gallery.querySelectorAll<HTMLElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => go(current() + Number(button.dataset.step)));
    });
    // The panel's contents fill it, so a click on the dialog itself landed on the backdrop.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        go(current() + (e.key === 'ArrowLeft' ? -1 : 1));
      }
    });
  });
</script>
