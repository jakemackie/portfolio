---
import { getPortfolio } from '../lib/content';
import { bannerPath, pagePath, siteSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  themeColor: string;
  colorScheme?: 'light' | 'dark' | 'light dark';
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
}

const { profile } = await getPortfolio();
const { title, description = profile.summary, themeColor, colorScheme = 'light', noindex, schema = [] } = Astro.props;
const site = Astro.site!;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role} in ${profile.location}`;
const path = pagePath(Astro.url.pathname);
const canonical = new URL(path, site);
const banner = new URL(noindex ? bannerPath('/') : bannerPath(path), site);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...(await siteSchema(site)), ...schema] });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<meta name="theme-color" content={themeColor} />
<meta name="color-scheme" content={colorScheme} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={banner} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={jsonLd.replace(/</g, '\\u003c')} />
