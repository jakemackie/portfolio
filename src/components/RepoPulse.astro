---
// Server island: rendered on the Worker at request time, so prerendered pages show current numbers.
import { getLiveEntry } from 'astro:content';

interface Props {
  repo: string;
  stars: number;
  pushedAt: string;
}

const { repo, stars, pushedAt } = Astro.props;
const { entry } = await getLiveEntry('repoStats', repo);
Astro.response.headers.set('Cache-Control', 'public, max-age=900');

const current = entry?.data ?? { stars, pushedAt: new Date(pushedAt) };

const relative = new Intl.RelativeTimeFormat('en-GB', { numeric: 'auto' });
function ago(date: Date) {
  const hours = (date.getTime() - Date.now()) / 3_600_000;
  if (hours > -1) return 'within the hour';
  if (hours > -24) return relative.format(Math.round(hours), 'hour');
  if (hours > -24 * 60) return relative.format(Math.round(hours / 24), 'day');
  return relative.format(Math.round(hours / (24 * 30)), 'month');
}
---

<span>{current.stars} {current.stars === 1 ? 'star' : 'stars'}, last push {ago(current.pushedAt)}</span>
