{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "404-page",
    // Pages are static. Only the live GitHub server island needs the Worker.
    "run_worker_first": ["/_server-islands/*"]
  }
  // Optional secret for the live GitHub island: `npx wrangler secret put GITHUB_TOKEN`
}
